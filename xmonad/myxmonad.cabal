cabal-version:      3.0
name:               myxmonad
version:            0.1.0.0
build-type:         Simple

common common
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-patterns -Wincomplete-uni-patterns
    -Wredundant-constraints -Werror=missing-fields
  build-depends:
      base
    , unix
    , xmonad
    , xmonad-contrib
    , containers
    , X11
  default-language: Haskell2010

library
  import: common
  hs-source-dirs: lib
  exposed-modules:
    MyXmonad

executable myxmonad
  import: common
  main-is: xmonad.hs
  build-depends:
    myxmonad
